# Copy to /root/MCat-next/.env and fill Telegram API values from the existing secure MCat configuration.
TG_API_ID=
TG_API_HASH=
TG_BOT_USERNAME=
# Not used in per-user mode; each website user selects a destination.
TG_DESTINATION=
TG_DEDUP_SOURCES=
# Job/search state for the second instance; keep separate from the existing app.
DB_PATH=/root/MCat-next/data/mcat.sqlite3
# Share web users/passwords with the existing app.
MCAT_WEB_AUTH_DB_PATH=/root/MCat/data/mcat.sqlite3
MCAT_WEB_USERNAME=
MCAT_WEB_PASSWORD=
MCAT_WEB_HOST=192.168.68.153
MCAT_WEB_PORT=8444
MCAT_WEB_COOKIE_SECURE=1
MCAT_WEB_SESSION_COOKIE=mcat_session_v2
MCAT_WEB_TG_MODE=per_user
# Only when the HTTP origin is reachable exclusively through a trusted private tunnel.
MCAT_WEB_ALLOW_HTTP_ORIGIN=1
# Generate a unique Fernet key and keep it private; losing it makes stored sessions unusable.
MCAT_WEB_TG_ENCRYPTION_KEY=
MCAT_WEB_SSL_CERTFILE=
MCAT_WEB_SSL_KEYFILE=

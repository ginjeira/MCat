TG_API_ID=
TG_API_HASH=
TG_BOT_USERNAME=
TG_DESTINATION=
# IDs adicionais consultados apenas para deduplicação, separados por vírgulas; nunca recebem envios.
TG_DEDUP_SOURCES=
DB_PATH=./data/mcat.sqlite3
# Credenciais da conta de acesso ao website; preencher antes de iniciar mcat-web.
MCAT_WEB_USERNAME=
MCAT_WEB_PASSWORD=
MCAT_WEB_HOST=127.0.0.1
MCAT_WEB_PORT=8080
MCAT_WEB_COOKIE_SECURE=1
MCAT_WEB_TG_SESSION=mcat_user_session
# Use per_user only on the separate account-linked instance.
MCAT_WEB_TG_MODE=shared
# Generate with Fernet.generate_key(); required for MCAT_WEB_TG_MODE=per_user.
MCAT_WEB_TG_ENCRYPTION_KEY=
# Optional separate web login store; defaults to DB_PATH.
MCAT_WEB_AUTH_DB_PATH=
MCAT_WEB_SESSION_COOKIE=mcat_session
MCAT_WEB_SSL_CERTFILE=
MCAT_WEB_SSL_KEYFILE=

